+import unittest
+from types import SimpleNamespace
+from unittest.mock import Mock,MagicMock,patch
+from scripts import build_ts_backlog as backlog
+
+class SourceRetryTest(unittest.TestCase):
+ def error(self, code):return Exception(SimpleNamespace(code=code))
+ def test_complete_stock_predicate_preserves_all_keys_with_bounded_in_lists(self):
+  names=[':c'+str(i) for i in range(15422)]
+  result=backlog.in_predicate('c.cntr_no',names)
+  groups=result[1:-1].split(' OR ')
+  self.assertEqual(sum(len(g[g.index('(')+1:-1].split(',')) for g in groups),len(names))
+  self.assertTrue(all(len(g[g.index('(')+1:-1].split(','))<=900 for g in groups))
+  self.assertIn(':c15421',result)
+ def test_history_scope_is_pinned_source_inventory_without_booking_or_age_cutoff(self):
+  predicate=backlog.stock_container_predicate('c.cntr_no')
+  self.assertIn('e.basc_dt=:stock_date',predicate)
+  self.assertIn("e.cntr_mvnt_cd='TS'",predicate)
+  self.assertIn("e.fe_cat_cd='F'",predicate)
+  self.assertNotIn('bkg_no',predicate)
+  self.assertNotIn('mvnt_dt',predicate)
+ def test_no_booking_keys_has_an_explicit_empty_predicate(self):
+  self.assertEqual(backlog.in_predicate('l.bkg_no',[]),'1=0')
+ def test_parallel_error_retries_readonly_query_with_serial_hints(self):
+  q=MagicMock();q.execute.side_effect=[self.error(12805),None,None,None];q.description=[('container',)];q.__iter__=Mock(return_value=iter([('C1',)]))
+  with patch.object(backlog.time,'sleep'):
+   self.assertEqual(backlog.fetch(q,'SELECT x FROM (SELECT x FROM source)'),[{'container':'C1'}])
+  self.assertEqual(q.execute.call_args_list[0].args[0].count('NO_PARALLEL'),2)
+  q.connection.rollback.assert_called_once()
+ def test_query_syntax_error_is_not_retried(self):
+  q=Mock();q.execute.side_effect=self.error(904)
+  with self.assertRaises(Exception):backlog.fetch(q,'SELECT missing FROM source')
+  self.assertEqual(q.execute.call_count,1)
+ def test_failed_connection_recaptures_in_a_new_session(self):
+  with patch.object(backlog,'_build_once',side_effect=[self.error(3114),{'meta':{'reconciled':True}}]) as build,patch.object(backlog.time,'sleep'):
+   self.assertTrue(backlog.build()['meta']['reconciled']);self.assertEqual(build.call_count,2)
+ def test_persistent_source_failure_is_bounded(self):
+  with patch.object(backlog,'_build_once',side_effect=self.error(12805)) as build,patch.object(backlog.time,'sleep'):
+   with self.assertRaises(Exception):backlog.build()
+   self.assertEqual(build.call_count,3)
+
+if __name__=='__main__':unittest.main()
+
+
