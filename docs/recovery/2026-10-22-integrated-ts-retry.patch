+import hashlib
+import json
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import MagicMock, patch
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'scripts'))
+import fetch_equipment_type_repair as repair
+
+
+class EquipmentSetQueryTests(unittest.TestCase):
+    def test_complete_scope_has_no_oracle_in_list_overflow(self):
+        numbers=[f'BL{i}' for i in range(17853)]
+        sql,binds=repair.equipment_query('bl_no','CS107D',numbers)
+        groups=sql.split('WHERE (')[1].split(')\n')[0].split(' OR ')
+        self.assertEqual(len(binds),17853)
+        self.assertEqual(list(binds.values()),numbers)
+        self.assertTrue(all(group.count(':')<=900 for group in groups))
+        self.assertIn('GROUP BY bl_no,cntr_sz_cd,cntr_typ_cd',sql)
+
+    def test_partial_legacy_cache_needs_one_read_per_table_and_resumes_without_reads(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root=Path(folder);(root/'oracle-dashboard').mkdir()
+            numbers=[f'BL{i:05}' for i in range(701)]
+            scope={'Booking':[],'B/L':numbers}
+            (root/'missing-documents.json').write_text(json.dumps(scope))
+            (root/'oracle-dashboard/manifest.json').write_text(json.dumps({'sourceMeta':{'generatedAt':'pinned','sourceAsOfDate':'20261022'}}))
+            signature=hashlib.sha256(json.dumps(['pinned',scope],sort_keys=True).encode()).hexdigest()
+            cache=root/'equipment-query-cache'/signature;cache.mkdir(parents=True)
+            # Include multiple equipment groups and a document with no source row.
+            expected=[[n,'20','GP',2] for n in numbers[:-1]]+[[numbers[400],'40','HC',1]]
+            for table in ['CS106I','CS107D']:
+                (cache/f'{table}-0.json').write_text(json.dumps([r for r in expected if r[0] in numbers[:300]]))
+            queries=[];cursor=MagicMock();connection=MagicMock()
+            connection.cursor.return_value.__enter__.return_value=cursor
+            rows=[]
+            def execute(sql,binds=None):
+                rows.clear()
+                if binds:
+                    queries.append((sql,binds))
+                    rows.extend([r for r in expected if r[0] in set(binds.values())])
+            cursor.execute.side_effect=execute
+            cursor.__iter__.side_effect=lambda:iter(rows)
+            with patch.object(repair.dashboard,'connect',return_value=connection):repair.fetch(root)
+            result=json.loads((root/'equipment-lookup.json').read_text())
+            self.assertEqual(len(queries),2)
+            for table in ['CS106I','CS107D']:
+                wanted={}
+                for number,size,equipment,count in expected:wanted.setdefault(number,[]).append({'size':size,'type':equipment,'rows':count})
+                self.assertEqual(result[table],wanted)
+                self.assertNotIn(numbers[-1],result[table])
+            with patch.object(repair.dashboard,'connect',side_effect=AssertionError('Resume must not query')):repair.fetch(root)
+            resumed=json.loads((root/'equipment-lookup.json').read_text())
+            self.assertEqual(resumed['CS107D'],result['CS107D'])
+
+
+if __name__=='__main__':unittest.main()
